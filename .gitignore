/target
**/*.rs.bk
# Local dev TLS certs (mkcert) — never commit private keys.
*.pem
# Machine-local cargo config (e.g. a per-machine target-dir). Committing an
# absolute path breaks other checkouts and the CI build cache. See
# .cargo/config.toml.example.
/.cargo/config.toml
# Local tooling / REPL state.
/.claude/
/.replxx_history
# Default runtime audit log output (see baston-config default_audit_log()).
/baston-audit.jsonl
# Runtime resource cache generated by local FiveM/BASTON runs.
/cache/
# Machine-local runtime configs may contain CFX licence keys or admin tokens.
*.local.toml
baston-live-test.log

# --- Node / the documentation website ---
node_modules/
apps/**/dist/
apps/**/.astro/

# --- The zone map editor ---
# Generated: the wasm validator is compiled and inlined into it. Committing it
# would let a stale copy validate maps with rules the server no longer has,
# which is the exact drift the shared crate exists to prevent.
/tools/zone-map-editor/zone-map-editor.html
